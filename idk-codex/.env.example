# ═══════════════════════════════════════════════════════════════
# MAX — Environment Variables Template
# Copy to .env or set in Railway dashboard
# ═══════════════════════════════════════════════════════════════

# ─── LLM PROVIDERS (only one needed, OpenRouter recommended for free) ───
# Free OpenRouter models including "auto" router (auto-picks best model)
OPENAI_COMPATIBLE_BASE_URL=https://openrouter.ai/api/v1
OPENAI_COMPATIBLE_API_KEY=sk-or-xxxxx
OPENAI_COMPATIBLE_MODEL=openrouter/auto

# Groq (free tier — used for Whisper voice transcription)
GROQ_API_KEY=gsk_xxxxx

# ─── SUPABASE (required for persistence) ───
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=eyJxxxxx                       # service_role key
SUPABASE_ANON_KEY=eyJxxxxx                  # anon key (for client-side auth)

# ─── TELEGRAM BOT ───
TELEGRAM_BOT_TOKEN=123456:ABC-DEF
AUTHORIZED_USER_ID=8372726288               # your Telegram user ID (optional)

# ─── UPSTASH REDIS (free tier — for rate limiting) ───
# Get at https://upstash.com — 10k commands/day free
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxx

# ─── SECURITY ───
# Generate with: openssl rand -hex 32
MAX_VAULT_KEY=generate-32-bytes-hex-here
ADMIN_SECRET=your-admin-secret-key

# ─── APP ───
NODE_ENV=production
PORT=8080
SANDBOX_WORKSPACE=./sandbox-workspace
MAX_AGENT_ITERATIONS=15

# ─── FRONTEND (Next.js) ───
NEXT_PUBLIC_API_URL=https://maxxxxx-production.up.railway.app
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxx

# ─── OPTIONAL: Webhooks / OAuth callbacks ───
FRONTEND_URL=https://your-max-app.railway.app

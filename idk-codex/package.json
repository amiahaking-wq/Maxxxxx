{
  "name": "max-agent",
  "version": "3.0.0",
  "description": "MAX — Professional autonomous AI agent: a multi-provider LLM coding agent with streaming, semantic memory, personality learning, computer use, and a CLI.",
  "main": "server.js",
  "type": "module",
  "bin": {
    "max": "./bin/max.js",
    "max-config": "./bin/max-config.js",
    "max-cli": "./max-cli.js"
  },
  "scripts": {
    "start": "node server.js",
    "start:prod": "node server.js",
    "dev": "node --watch server.js",
    "frontend:dev": "cd max-frontend && npm run dev",
    "frontend:build": "cd max-frontend && npm install && npm run build",
    "frontend:start": "cd max-frontend && npm run start",
    "dev:all": "concurrently \"npm run dev\" \"npm run frontend:dev\"",
    "init-db": "node src/database/init-db.js",
    "db:reset": "node scripts/reset-db.js",
    "postinstall": "chmod +x bin/max.js bin/max-config.js || true"
  },
  "keywords": [
    "telegram",
    "bot",
    "ci-cd",
    "autonomous",
    "ai-agent",
    "groq",
    "github",
    "openrouter",
    "ollama",
    "anthropic",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@babel/core": "^7.24.0",
    "@babel/generator": "^7.24.0",
    "@babel/parser": "^7.24.0",
    "@babel/traverse": "^7.24.0",
    "@babel/types": "^7.24.0",
    "@google/generative-ai": "^0.21.0",
    "@octokit/rest": "^20.1.1",
    "@supabase/storage-js": "^2.7.0",
    "@upstash/redis": "^1.38.0",
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.16.1",
    "better-sqlite3": "^11.10.0",
    "chalk": "^5.3.0",
    "concurrently": "^8.2.2",
    "cors": "^2.8.6",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^7.4.0",
    "fs-safe": "^1.2.0",
    "gpt-tokenizer": "^3.0.0",
    "groq-sdk": "^0.7.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "pdf-parse": "^1.1.1",
    "playwright": "^1.48.0",
    "recast": "^0.23.4",
    "ruflo": "^3.10.10",
    "simple-git": "^3.27.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "telegraf": "^4.16.3",
    "winston": "^3.15.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
